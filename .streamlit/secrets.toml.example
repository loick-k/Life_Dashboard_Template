# Copie la chaîne de connexion « pooled » fournie par Neon dans les secrets
# de Streamlit Community Cloud. Ne committe jamais le vrai fichier secrets.toml.
DATABASE_URL = "postgresql://utilisateur:mot-de-passe@hote-pooler.neon.tech/base?sslmode=require"

# Jeton personnel disponible dans Todoist > Réglages > Intégrations > Développeur.
TODOIST_API_TOKEN = "colle-ton-jeton-personnel-ici"

# Obligatoire dès qu'une base externe est configurée.
# Utilise un mot de passe long et unique.
APP_ACCESS_PASSWORD = "remplace-par-un-mot-de-passe-long-et-unique"

# Option recommandée : connexion Google persistante. Lorsqu'elle est configurée,
# elle remplace l'écran de mot de passe ci-dessus.
APP_ALLOWED_EMAILS = ["votre-adresse@gmail.com"]

[auth]
redirect_uri = "https://votre-application.streamlit.app/oauth2callback"
cookie_secret = "generez-une-longue-valeur-aleatoire"
client_id = "votre-client-id-google.apps.googleusercontent.com"
client_secret = "votre-secret-client-google"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
