{
  "name": "life-dashboard-mobile",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "main": "index.ts",
  "scripts": {
    "v1:bundle": "node --experimental-strip-types scripts/package-v1-snapshot.mjs",
    "clean-dev-storage": "pwsh -NoProfile -File scripts/clean-dev-storage.ps1",
    "migrations:bundle": "node scripts/bundle-migrations.mjs",
    "pretypecheck": "npm run migrations:bundle",
    "pretest": "npm run migrations:bundle",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "expo": "~57.0.25",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
